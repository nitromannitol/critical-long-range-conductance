import LongRangeHeat.Statements.AldousOfDavies
import LongRange.Support.External.ChenKimKumagaiWangDaviesProof

/-!
# Proposition 4.2 without cited hypotheses

Proposition 4.2 (`prop:aldous`) of the heat-kernel version, with every input of
Proposition 4.1 proved.
-/

namespace LongRangeHeat.Statements

open MeasureTheory Filter LatticeProb LatticeProb.Cadlag.HalfLine LatticeProb.Euclidean.Lattice
open scoped NNReal ENNReal Topology
open LongRange (Edge walkRates walkEmbed)

/-- **Proposition 4.2** (`prop:aldous`, Aldous' criterion). Let `(ε_n)` be a sequence in `(0, 1/2)`
converging to `0`, let `m > 0`, and for every `n` let `τ_n ≤ m` be a stopping time of the
canonical filtration of the path space `D([0, ∞), ℝ^d)` (the natural filtration of the coordinate
process), that is, `{τ_n ≤ t}` lies in the σ-algebra generated by the coordinates up to time `t`
for every `t`. Let `(h_n)` be positive numbers converging to `0`. Then, under the annealed law
`P^ann_0 = E[P^a_0]` of the walk `X^{ε_n}`, the differences `X_{τ_n + h_n} - X_{τ_n}` converge
to `0` in probability: for every `η > 0`,
`P^ann_0[η < |X_{τ_n + h_n} - X_{τ_n}|] → 0`.

The heat-kernel bounds of Proposition 4.1 enter through `heat_kernel_bounds_unconditional`;
no cited result is assumed. -/
theorem aldous_condition_unconditional
    {d : ℕ} (hd : 1 ≤ d) {lam : ℝ}
    {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω) (a : Ω → Edge d → ℝ)
    (hP : ConductanceLaw P lam a)
    (ε : ℕ → ℝ) (hε : ∀ n, ε n ∈ Set.Ioo (0 : ℝ) (1 / 2)) (hε0 : Tendsto ε atTop (𝓝 0))
    (m : ℝ) (hm : 0 < m)
    (τ : ℕ → LongRangeHeat.PathSpace d → ℝ)
    (hτ : ∀ n (t : ℝ≥0), MeasurableSet[LongRangeHeat.canonicalSigma d t] {X | τ n X ≤ t})
    (hτ0 : ∀ n X, 0 ≤ τ n X) (hτm : ∀ n X, τ n X ≤ m)
    (h : ℕ → ℝ) (hh : ∀ n, 0 < h n) (hh0 : Tendsto h atTop (𝓝 0))
    {η : ℝ} (hη : 0 < η) :
    Tendsto (fun n => (LongRangeHeat.annealedLaw hd P a hP (hε n).1 :
        Measure (LongRangeHeat.PathSpace d))
      {X | η < ‖X.1 (τ n X + h n).toNNReal - X.1 (τ n X).toNNReal‖}) atTop (𝓝 0) :=
  aldous_condition_of_davies LatticeProb.External.chenKimKumagaiWangDavies_holds hd P a hP
    ε hε hε0 m hm τ hτ hτ0 hτm h hh hh0 hη

end LongRangeHeat.Statements
