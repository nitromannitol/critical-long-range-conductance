import LongRangeHeat.Aldous
import LongRangeHeat.Statements.HeatKernelBoundsProved

/-!
# Proposition 4.2: Aldous' criterion

Statement of Proposition 4.2 (`prop:aldous`) of the heat-kernel version: under the annealed law,
the increments of the walks `X^{ε_n}` after bounded stopping times of their canonical filtration
tend to zero in probability.
-/

namespace LongRangeHeat.Statements

open MeasureTheory Filter LatticeProb LatticeProb.Cadlag.HalfLine LatticeProb.Euclidean.Lattice
open scoped NNReal ENNReal Topology
open LongRange (Edge walkRates walkEmbed)

/-- **Proposition 4.2** (`prop:aldous`, Aldous' criterion). Let `(ε_n)` be a sequence in `(0, 1/2)`
converging to `0`, let `m > 0`, and for every `n` let `τ_n ≤ m` be a stopping time of the
canonical filtration of the path space `D([0, ∞), ℝ^d)` (the natural filtration of the coordinate
process), that is, `{τ_n ≤ t}` lies in the σ-algebra generated by the coordinates up to time `t`
for every `t`. Let `(h_n)` be positive numbers converging to `0`. Then, under the annealed law
`P^ann_0 = E[P^a_0]` of the walk `X^{ε_n}`, the differences `X_{τ_n + h_n} - X_{τ_n}` converge
to `0` in probability: for every `η > 0`,
`P^ann_0[η < |X_{τ_n + h_n} - X_{τ_n}|] → 0`.

The heat-kernel inputs of Proposition 4.1 enter as the hypotheses `hNash` and
`hDavies`. -/
theorem aldous_condition_proved
    (hNash : LatticeProb.External.ChenKimKumagaiWangNash)
    (hDavies : LatticeProb.External.ChenKimKumagaiWangDavies)
    {d : ℕ} (hd : 1 ≤ d) {lam : ℝ}
    {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω) (a : Ω → Edge d → ℝ)
    (hP : ConductanceLaw P lam a)
    (ε : ℕ → ℝ) (hε : ∀ n, ε n ∈ Set.Ioo (0 : ℝ) (1 / 2)) (hε0 : Tendsto ε atTop (𝓝 0))
    (m : ℝ) (_hm : 0 < m)
    (τ : ℕ → LongRangeHeat.PathSpace d → ℝ)
    (hτ : ∀ n (t : ℝ≥0), MeasurableSet[LongRangeHeat.canonicalSigma d t] {X | τ n X ≤ t})
    (hτ0 : ∀ n X, 0 ≤ τ n X) (_hτm : ∀ n X, τ n X ≤ m)
    (h : ℕ → ℝ) (hh : ∀ n, 0 < h n) (hh0 : Tendsto h atTop (𝓝 0))
    {η : ℝ} (hη : 0 < η) :
    Tendsto (fun n => (LongRangeHeat.annealedLaw hd P a hP (hε n).1 :
        Measure (LongRangeHeat.PathSpace d))
      {X | η < ‖X.1 (τ n X + h n).toNNReal - X.1 (τ n X).toNNReal‖}) atTop (𝓝 0) := by
  obtain ⟨C, hC, hbound⟩ := LongRangeHeat.Statements.heat_kernel_bounds_proved hNash hDavies hd
    hP.lam_mem
  set c : ℝ := C * (1 + Real.log (1 + η)) / η ^ 2 with hc
  have hc0 : 0 ≤ c := by
    have : 0 ≤ Real.log (1 + η) := Real.log_nonneg (by linarith)
    positivity
  have hlim : Tendsto (fun n => ENNReal.ofReal (c * h n)) atTop (𝓝 0) := by
    have := (ENNReal.tendsto_ofReal ((hh0.const_mul c))).congr' (Eventually.of_forall fun n => rfl)
    simpa using this
  have hev : ∀ᶠ n in atTop, ε n ≤ η := by
    have := hε0.eventually (ge_mem_nhds hη)
    exact this
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hlim
    (Eventually.of_forall fun n => bot_le) ?_
  filter_upwards [hev] with n hn
  have hsub : {X : LongRangeHeat.PathSpace d | η < ‖X.1 (τ n X + h n).toNNReal -
      X.1 (τ n X).toNNReal‖} = {X | η < dist (X.1 ((τ n X).toNNReal + (h n).toNNReal))
        (X.1 (τ n X).toNNReal)} := by
    ext X
    simp only [Set.mem_ofPred_eq, dist_eq_norm, Real.toNNReal_add (hτ0 n X) (hh n).le]
  rw [hsub]
  refine LongRangeHeat.annealedLaw_stopping_le hd P a hP (hε n).1 (hτ n) (hτ0 n) (h n).toNNReal
    η _ ?_
  intro ω y
  have hk := ((hbound (ε n) (hε n) (a ω) (hP.bounds ω) y y).2 (h n).toNNReal
    (by simpa using hh n) η hn)
  have hset : {z | η < dist (walkEmbed (ε n) z) (walkEmbed (ε n) y)} =
      {z | η < radius (physical (ε n) (z - y))} := by
    ext z
    have hphys : physical (ε n) (z - y) = physical (ε n) z - physical (ε n) y := by
      funext k
      simp [physical, mul_sub]
    simp only [Set.mem_ofPred_eq, LongRange.dist_walkEmbed, hphys]
  rw [hset, ← ofReal_measureReal (measure_ne_top _ _)]
  refine ENNReal.ofReal_le_ofReal (hk.trans_eq ?_)
  rw [hc, Real.coe_toNNReal _ (hh n).le]
  ring

end LongRangeHeat.Statements
