import LongRangeHeat.FddAlgebra
import Mathlib.MeasureTheory.Measure.LevyConvergence

/-!
# Weak convergence on `(ℝ^d)^k` from the integrals of products of test functions

A tight family of probability measures on `(ℝ^d)^k` converges weakly to `μ₀` as soon as the
integrals of all the products `x ↦ ∏_{j ∈ S} ψ_j(x_j)`, with `S ⊆ {1, …, k}` and test functions
`ψ_j ∈ C_c^∞(ℝ^d)`, converge to those against `μ₀`: the algebra generated by these products
separates points and `ProbabilityMeasure.tendsto_of_tight_of_separatesPoints` applies.
-/

namespace LongRangeHeat

open MeasureTheory Filter Set Topology
open scoped ContDiff BoundedContinuousFunction

noncomputable section

variable {d k : ℕ}

/-- The product `x ↦ ∏_{j ∈ S} ψ_j(x_j)`. -/
def subProd (S : Finset (Fin k)) (ψ : Fin k → (Fin d → ℝ) → ℝ)
    (x : Fin k → EuclideanSpace ℝ (Fin d)) : ℝ :=
  ∏ j ∈ S, ψ j (WithLp.ofLp (x j))

theorem exists_bound_testFunction {ψ : (Fin d → ℝ) → ℝ} (hψ : IsTestFunction ψ) :
    ∃ B, ∀ y, |ψ y| ≤ B := by
  obtain ⟨B, hB⟩ := hψ.1.continuous.bounded_above_of_compact_support hψ.2
  exact ⟨B, fun y => by simpa using hB y⟩

theorem continuous_coord_comp {ψ : (Fin d → ℝ) → ℝ} (hψ : Continuous ψ) (j : Fin k) :
    Continuous fun x : Fin k → EuclideanSpace ℝ (Fin d) => ψ (WithLp.ofLp (x j)) :=
  hψ.comp ((PiLp.continuous_ofLp 2 (fun _ : Fin d => ℝ)).comp (continuous_apply j))

theorem continuous_subProd (S : Finset (Fin k)) {ψ : Fin k → (Fin d → ℝ) → ℝ}
    (hψ : ∀ j, IsTestFunction (ψ j)) : Continuous (subProd S ψ) :=
  continuous_finsetProd _ fun j _ => continuous_coord_comp (hψ j).1.continuous j

theorem exists_bound_subProd (S : Finset (Fin k)) {ψ : Fin k → (Fin d → ℝ) → ℝ}
    (hψ : ∀ j, IsTestFunction (ψ j)) : ∃ M, ∀ x, |subProd S ψ x| ≤ M := by
  choose B hB using fun j => exists_bound_testFunction (hψ j)
  refine ⟨∏ j ∈ S, B j, fun x => ?_⟩
  rw [subProd, Finset.abs_prod]
  exact Finset.prod_le_prod₀ (fun _ _ => abs_nonneg _) fun j _ => hB j _

theorem continuous_tensorFun (c : Fin k → ℝ) {ψ : Fin k → (Fin d → ℝ) → ℝ}
    (hψ : ∀ j, IsTestFunction (ψ j)) : Continuous (tensorFun c ψ) :=
  continuous_finsetProd _ fun j _ =>
    continuous_const.add (continuous_coord_comp (hψ j).1.continuous j)

theorem exists_bound_tensorFun (c : Fin k → ℝ) {ψ : Fin k → (Fin d → ℝ) → ℝ}
    (hψ : ∀ j, IsTestFunction (ψ j)) : ∃ M, ∀ x, |tensorFun c ψ x| ≤ M := by
  choose B hB using fun j => exists_bound_testFunction (hψ j)
  refine ⟨∏ j, (|c j| + B j), fun x => ?_⟩
  rw [tensorFun, Finset.abs_prod]
  exact Finset.prod_le_prod₀ (fun _ _ => abs_nonneg _) fun j _ =>
    (abs_add_le _ _).trans (add_le_add_right (hB j _) _)

theorem tensorFun_eq_sum (c : Fin k → ℝ) (ψ : Fin k → (Fin d → ℝ) → ℝ)
    (x : Fin k → EuclideanSpace ℝ (Fin d)) :
    tensorFun c ψ x = ∑ S ∈ (Finset.univ : Finset (Fin k)).powerset,
      subProd S ψ x * ∏ j ∈ Finset.univ \ S, c j := by
  have : tensorFun c ψ x = ∏ j, (ψ j (WithLp.ofLp (x j)) + c j) :=
    Finset.prod_congr rfl fun j _ => add_comm _ _
  rw [this, Finset.prod_add (fun j => ψ j (WithLp.ofLp (x j))) c]
  rfl

section Assembly

variable {ι : Type*} {l : Filter ι}

theorem integral_tensorFun (c : Fin k → ℝ) {ψ : Fin k → (Fin d → ℝ) → ℝ}
    (hψ : ∀ j, IsTestFunction (ψ j)) (ν : Measure (Fin k → EuclideanSpace ℝ (Fin d)))
    [IsFiniteMeasure ν] :
    ∫ x, tensorFun c ψ x ∂ν = ∑ S ∈ (Finset.univ : Finset (Fin k)).powerset,
      (∏ j ∈ Finset.univ \ S, c j) * ∫ x, subProd S ψ x ∂ν := by
  have hint : ∀ S : Finset (Fin k),
      Integrable (fun x => subProd S ψ x * ∏ j ∈ Finset.univ \ S, c j) ν := fun S => by
    obtain ⟨M, hM⟩ := exists_bound_subProd S hψ
    exact (Integrable.of_bound (continuous_subProd S hψ).aestronglyMeasurable M
      (Eventually.of_forall fun x => by simpa using hM x)).mul_const _
  simp_rw [tensorFun_eq_sum]
  rw [integral_finsetSum _ fun S _ => hint S]
  refine Finset.sum_congr rfl fun S _ => ?_
  rw [integral_mul_const, mul_comm]

/-- Weak convergence on `(ℝ^d)^k` from the tightness and the convergence of the integrals of the
products `∏_{j ∈ S} ψ_j(x_j)` of test functions. -/
theorem tendsto_of_tight_of_subProd
    {μ : ι → ProbabilityMeasure (Fin k → EuclideanSpace ℝ (Fin d))}
    {μ₀ : ProbabilityMeasure (Fin k → EuclideanSpace ℝ (Fin d))}
    (h_tight : IsTightMeasureSet (range fun i => (μ i : Measure (Fin k → EuclideanSpace ℝ (Fin d)))))
    (hsub : ∀ (S : Finset (Fin k)) (ψ : Fin k → (Fin d → ℝ) → ℝ), (∀ j, IsTestFunction (ψ j)) →
      Tendsto (fun i => ∫ x, subProd S ψ x ∂(μ i : Measure (Fin k → EuclideanSpace ℝ (Fin d)))) l
        (𝓝 (∫ x, subProd S ψ x ∂(μ₀ : Measure (Fin k → EuclideanSpace ℝ (Fin d)))))) :
    Tendsto μ l (𝓝 μ₀) := by
  refine ProbabilityMeasure.tendsto_of_tight_of_separatesPoints ℝ (A := tensorAlgebra d k)
    (by simpa [Set.range] using h_tight) (separatesPoints_tensorAlgebra d k) ?_
  intro G hG
  have key := tensorAlgebra_induction (d := d) (k := k)
    (Q := fun F => Continuous F ∧ (∃ M, ∀ x, |F x| ≤ M) ∧
      Tendsto (fun i => ∫ x, F x ∂(μ i : Measure (Fin k → EuclideanSpace ℝ (Fin d)))) l (𝓝 (∫ x, F x ∂(μ₀ : Measure (Fin k → EuclideanSpace ℝ (Fin d))))))
    ?_ ?_ ?_ ?_ hG
  · exact key.2.2
  · refine ⟨continuous_zero, ⟨0, fun x => by simp⟩, ?_⟩
    simpa using tendsto_const_nhds
  · rintro F G ⟨hFc, ⟨M₁, hM₁⟩, hF⟩ ⟨hGc, ⟨M₂, hM₂⟩, hG⟩
    have hFi : ∀ ν : Measure (Fin k → EuclideanSpace ℝ (Fin d)), IsFiniteMeasure ν →
        Integrable F ν := fun ν _ =>
      Integrable.of_bound hFc.aestronglyMeasurable M₁ (Eventually.of_forall fun x => by
        simpa using hM₁ x)
    have hGi : ∀ ν : Measure (Fin k → EuclideanSpace ℝ (Fin d)), IsFiniteMeasure ν →
        Integrable G ν := fun ν _ =>
      Integrable.of_bound hGc.aestronglyMeasurable M₂ (Eventually.of_forall fun x => by
        simpa using hM₂ x)
    refine ⟨hFc.add hGc, ⟨M₁ + M₂, fun x => (abs_add_le _ _).trans (add_le_add (hM₁ x) (hM₂ x))⟩,
      ?_⟩
    simp only [Pi.add_apply]
    simp_rw [integral_add (hFi _ inferInstance) (hGi _ inferInstance)]
    exact hF.add hG
  · rintro r F ⟨hFc, ⟨M, hM⟩, hF⟩
    refine ⟨hFc.const_smul r, ⟨|r| * M, fun x => ?_⟩, ?_⟩
    · simp only [Pi.smul_apply, smul_eq_mul, abs_mul]
      exact mul_le_mul_of_nonneg_left (hM x) (abs_nonneg _)
    · simp only [Pi.smul_apply, smul_eq_mul]
      simp_rw [integral_const_mul]
      exact hF.const_mul r
  · intro c ψ hψ
    refine ⟨continuous_tensorFun c hψ, exists_bound_tensorFun c hψ, ?_⟩
    simp_rw [integral_tensorFun c hψ]
    exact tendsto_finsetSum _ fun S _ => (hsub S ψ hψ).const_mul _

end Assembly

end

end LongRangeHeat
